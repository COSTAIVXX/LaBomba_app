rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)).data.isAdmin == true;
    }
    function isMaster() {
      return isAuth() && request.auth.token.email == 'gustavodionisio15x@gmail.com';
    }
    function isSuperAdmin() { return isAdmin() || isMaster(); }

    // Users
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId
        && ( !("vip" in request.resource.data) || request.resource.data.vip == resource.data.vip )
        && ( !("stats" in request.resource.data) || request.resource.data.stats == resource.data.stats );
      allow delete: if isAuth() && request.auth.uid == userId;

      match /notifications/{noteId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow create: if request.auth.token.admin == true;
        allow update, delete: if request.auth.token.admin == true || (isAuth() && request.auth.uid == userId);
      }
    }

    // Posts
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true)
        && ( !("vip" in request.resource.data) || request.resource.data.vip == resource.data.vip )
        && ( !("stats" in request.resource.data) || request.resource.data.stats == resource.data.stats );
      allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);

      match /reactions/{reactionId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow delete: if isAuth() && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      }

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);
        allow delete: if isAuth() && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);

        match /reactions/{reactionId} {
          allow read: if isAuth();
          allow create: if isAuth();
          allow delete: if isAuth() && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
        }
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if request.auth.token.admin == true;

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth() && (
          request.auth.uid == resource.data.senderId
          || (
            (request.resource.data.keys().hasOnly(['isRead','deliveredAt'])
             && request.auth.uid != resource.data.senderId)
          )
        );
        allow delete: if request.auth.token.admin == true;
      }
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if request.auth.token.admin == true || request.auth.uid in resource.data.admins;
      allow delete: if request.auth.token.admin == true || request.auth.uid in resource.data.admins;

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuth() && (
          request.auth.uid == resource.data.senderId
          || (request.resource.data.keys().hasOnly(['isRead','deliveredAt']) && request.auth.uid != resource.data.senderId)
        );
      }
    }

    // Broadcasts
    match /broadcasts/{b} {
      allow read: if isAuth();
      allow create: if request.auth.token.admin == true;
      allow update, delete: if request.auth.token.admin == true;
    }

    // Default: deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
